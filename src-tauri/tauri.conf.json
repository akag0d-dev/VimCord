{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VimCord",
  "version": "0.1.0",
  "identifier": "akag0d.vimcord.desktop.client",
  "build": {
    "frontendDist": "../vimcord/client/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VimCord",
        "width": 460,
        "height": 620,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
